# ---------------------------------------------------------------------------
# Velmora — environment template. Copy to .env. NEVER commit .env or real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Velmora
APP_ENV=local                 # local | testing | staging | production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=true                # MUST be false outside local
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC              # storage is always UTC; display timezone below
APP_DISPLAY_TIMEZONE=Asia/Dhaka
APP_LOCALE=en                 # default language (owner decision: English)
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,bn
APP_FAKER_LOCALE=en_US
# Maintenance mode is switched from the admin area (Settings). "file" works on one server; use "cache" (with a shared store) when there are several.
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id          # argon2id | bcrypt (fallback)
ARGON_MEMORY=65536            # KiB; lower only in tests
ARGON_TIME=4
ARGON_THREADS=1

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MariaDB >= 11.4 (ADR-000). Tests use velmora_test and WIPE it. -
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=velmora
DB_USERNAME=
DB_PASSWORD=
DB_TEST_DATABASE=velmora_test

# --- Session / cache / queue -----------------------------------------------
SESSION_DRIVER=redis          # `database` also works without Redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # MUST be true when APP_ENV is not local
CACHE_STORE=database          # redis in staging/production
QUEUE_RUN_FROM_SCHEDULER=false  # true on shared hosting (no always-on worker): the cron-run scheduler drains the queue each minute
QUEUE_CONNECTION=database     # redis in staging/production (Horizon)
BROADCAST_CONNECTION=log

# --- Redis (docker compose service `redis`) --------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

# --- Object storage (S3-compatible; MinIO locally) --------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=velmora                   # local SeaweedFS dev credentials; real keys only via secret manager
AWS_SECRET_ACCESS_KEY=velmora-dev-secret   # dev only (matches compose.yaml)
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=http://127.0.0.1:9010       # local S3 (SeaweedFS); empty for real AWS
AWS_USE_PATH_STYLE_ENDPOINT=true
MEDIA_PUBLIC_BUCKET=velmora-media          # public catalog media
MEDIA_PRIVATE_BUCKET=velmora-private       # digital goods + attachments (never public)

# --- Mail (Mailpit locally) ------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1035
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@velmora.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Business defaults (overridable in admin settings) ----------------------
VELMORA_CURRENCY=BDT
TAX_ENABLED=false                          # owner not VAT-registered yet (ADR-030)
TAX_PRICES_INCLUDE_TAX=true

# --- Providers: leave empty locally; credentials are entered by a human at go-live
SMS_DRIVER=log                             # log | fake | sslwireless
# SSLW_SMS_API_TOKEN=                       # SSL Wireless ISMS Plus (docs/vendor/sslwireless); secret: set it on the server only. This server's IP must be whitelisted in their portal
# SSLW_SMS_SID=                             # the registered sender id
# SSLW_SMS_BASE_URL=https://smsplus.sslwireless.com/api/v3
PUSH_DRIVER=log                            # log | fake | fcm
# FCM_SERVICE_ACCOUNT_FILE=                 # absolute path to the Firebase service account JSON (docs/vendor/fcm); a secret: outside the web root, never in git
# FCM_PROJECT_ID=                           # optional; the file's own project is used when empty
# OTP_THROTTLE_PER_TEN_MINUTES=3                 # route throttle on pages that ask for / check a code, per address (production values; only the browser tests raise them)
# OTP_THROTTLE_PER_HOUR=10
# AUTH_THROTTLE_PER_MINUTE=10                    # sign-in / sign-up / reset tries per minute per address (production value; only the browser tests raise it)
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
PAYMENT_SSLCOMMERZ_STORE_ID=
PAYMENT_SSLCOMMERZ_STORE_PASSWORD=
PAYMENT_SSLCOMMERZ_SANDBOX=true
# Use SANDBOX credentials only in development (a sandbox store id and password normally end in @ssl). Live credentials belong only in the production secret store.
# The real (live) gateway is reachable only with APP_ENV=production AND PAYMENT_SSLCOMMERZ_SANDBOX=false AND this set to true. Leave false everywhere else.
PAYMENTS_ALLOW_LIVE=false
PAYMENTS_EXPIRY_MINUTES=30
PAYMENTS_REFUND_SECOND_APPROVER_MINOR=500000
PAYMENTS_RECONCILE_AFTER_MINUTES=10
PAYMENTS_LONG_PENDING_HOURS=2
PAYMENTS_ALERT_WINDOW_MINUTES=15
PAYMENTS_ALERT_MIN_NOTIFICATIONS=5
PAYMENTS_ALERT_FAILURE_PERCENT=20
PAYMENTS_ALERT_PENDING_GRACE_MINUTES=15
PAYMENTS_ALERT_FORGED_THRESHOLD=3

# --- Security
TRUSTED_PROXIES=              # comma-separated proxy IPs/CIDRs, or * behind a trusted load balancer
CSP_ENABLED=true
CSP_ENFORCE=true              # enforced (Phase 12). false only to diagnose a violation (reports instead of blocking); never in production

# --- Observability / frontend ----------------------------------------------
HEALTH_TOKEN=                              # optional token for /readyz details
VITE_APP_NAME="${APP_NAME}"

# Shipping (see config/shipping.php)
SHIPPING_MAX_DELIVERY_ATTEMPTS=3
SHIPPING_POLL_BATCH=100
SHIPPING_STUCK_DAYS=7
SHIPPING_RETURN_WINDOW_DAYS=7
