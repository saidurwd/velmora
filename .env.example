# ---------------------------------------------------------------------------
# Velmora — environment template. Copy to .env. NEVER commit .env or real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Velmora
APP_ENV=local                 # local | testing | staging | production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=true                # MUST be false outside local
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC              # storage is always UTC; display timezone below
APP_DISPLAY_TIMEZONE=Asia/Dhaka
APP_LOCALE=en                 # default language (owner decision: English)
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,bn
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MariaDB >= 11.4 (ADR-000). Tests use velmora_test and WIPE it. -
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=velmora
DB_USERNAME=
DB_PASSWORD=
DB_TEST_DATABASE=velmora_test

# --- Session / cache / queue -----------------------------------------------
SESSION_DRIVER=database       # switch to redis once Redis is up
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # MUST be true when APP_ENV is not local
CACHE_STORE=database          # redis in staging/production
QUEUE_CONNECTION=database     # redis in staging/production (Horizon)
BROADCAST_CONNECTION=log

# --- Redis (docker compose service `redis`) --------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

# --- Object storage (S3-compatible; MinIO locally) --------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=velmora                   # local SeaweedFS dev credentials; real keys only via secret manager
AWS_SECRET_ACCESS_KEY=velmora-dev-secret   # dev only (matches compose.yaml)
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=http://127.0.0.1:9010       # local S3 (SeaweedFS); empty for real AWS
AWS_USE_PATH_STYLE_ENDPOINT=true
MEDIA_PUBLIC_BUCKET=velmora-media          # public catalog media
MEDIA_PRIVATE_BUCKET=velmora-private       # digital goods + attachments (never public)

# --- Mail (Mailpit locally) ------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1035
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@velmora.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Business defaults (overridable in admin settings) ----------------------
VELMORA_CURRENCY=BDT
TAX_ENABLED=false                          # owner not VAT-registered yet (ADR-030)
TAX_PRICES_INCLUDE_TAX=true

# --- Providers: leave empty locally; credentials are entered by a human at go-live
SMS_DRIVER=log                             # log | fake | sslwireless
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
PAYMENT_SSLCOMMERZ_STORE_ID=
PAYMENT_SSLCOMMERZ_STORE_PASSWORD=
PAYMENT_SSLCOMMERZ_SANDBOX=true

# --- Security
TRUSTED_PROXIES=              # comma-separated proxy IPs/CIDRs, or * behind a trusted load balancer
CSP_ENABLED=true
CSP_ENFORCE=false             # report-only until Phase 12

# --- Observability / frontend ----------------------------------------------
HEALTH_TOKEN=                              # optional token for /readyz details
VITE_APP_NAME="${APP_NAME}"
